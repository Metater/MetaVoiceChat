  m_Name: Low Latency OnAudioFilterRead VC Config
  m_EditorClassIdentifier: MetaVoiceChat.Core::MetaVoiceChat.Core.OnAudioFilterReadVcConfig
  notes: 'To use this config, please ensure:

    - Project Settings/Audio/DSP Buffer
    Size = Best latency

    - Frame size is 10 ms

    - Frequency is 48 kHz

    -
    Don''t target low end devices or devices with bad internet connections'
  resamplerQuality: 4
  resamplerBufferMs: 10
  maxPacketsInBuffer: 8
  maxDelayMs: 80
  minDelayMs: 10
  additionalDelayMs: 0
